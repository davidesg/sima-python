__pycache__/
*.pyc
build/
dist/
*.egg-info/
.pytest_cache/
*.sima.json

# generated by tools/sync_material.py (the wheel carries it)
src/sima/material/

# a job's run-time files (sima.jobs): the worked examples' caches keep only
# job.json, result.json and the engine's files (tools/build_example_caches.py)
**/sima_jobs/*/heartbeat
**/sima_jobs/*/runner.log
**/sima_jobs/*/progress.json
**/sima_jobs/*/c/
